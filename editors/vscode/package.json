{
  "name": "cyrs-vscode",
  "displayName": "cyrs — Cypher / GQL Language Support",
  "description": "Syntax highlighting and language-server integration for Cypher / GQL, powered by cypher-lsp.",
  "version": "0.0.1",
  "publisher": "phall1",
  "license": "Apache-2.0 OR MIT",
  "private": true,
  "preview": true,
  "icon": "icon.png",
  "categories": ["Programming Languages", "Linters", "Formatters"],
  "keywords": ["cypher", "gql", "neo4j", "graph", "language-server"],
  "repository": {
    "type": "git",
    "url": "https://github.com/phall1/cyrs.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/phall1/cyrs/issues"
  },
  "homepage": "https://github.com/phall1/cyrs/tree/main/editors/vscode",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:cypher"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cypher",
        "aliases": ["Cypher", "GQL", "cypher", "gql"],
        "extensions": [".cyp", ".cypher", ".gql"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cypher",
        "scopeName": "source.cypher",
        "path": "./syntaxes/cypher.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cyrs.restartServer",
        "title": "cyrs: Restart Language Server",
        "category": "cyrs"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "cyrs",
      "properties": {
        "cyrs.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the `cypher-lsp` binary. When empty, the extension looks up `cypher-lsp` on $PATH (mirrors the Neovim demo).",
          "scope": "machine-overridable"
        },
        "cyrs.server.extraEnv": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" },
          "description": "Extra environment variables passed to the language-server child process.",
          "scope": "machine-overridable"
        },
        "cyrs.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace LSP traffic in the cyrs output channel.",
          "scope": "window"
        },
        "cyrs.schema.source": {
          "type": "string",
          "enum": ["none", "file", "command"],
          "default": "none",
          "description": "Schema source forwarded as `initializationOptions.schemaSource` (spec §14.3).",
          "scope": "resource"
        },
        "cyrs.schema.path": {
          "type": "string",
          "default": "",
          "description": "Path to a schema JSON file (used when `cyrs.schema.source` = `file`).",
          "scope": "resource"
        },
        "cyrs.schema.command": {
          "type": "string",
          "default": "",
          "description": "Shell command whose stdout is parsed as a schema JSON document (used when `cyrs.schema.source` = `command`).",
          "scope": "resource"
        },
        "cyrs.dialect": {
          "type": "string",
          "enum": ["GqlAligned", "OpenCypherV9"],
          "default": "GqlAligned",
          "description": "Parser/sema dialect forwarded as `initializationOptions.dialect`.",
          "scope": "resource"
        },
        "cyrs.formatting.width": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "description": "Soft column limit forwarded to `cypher-fmt` (spec §13.3).",
          "scope": "resource"
        },
        "cyrs.formatting.keywordCasing": {
          "type": "string",
          "enum": ["Upper", "Lower", "Preserve"],
          "default": "Upper",
          "description": "Keyword casing policy for `cypher-fmt`.",
          "scope": "resource"
        },
        "cyrs.formatting.trailingCommas": {
          "type": "string",
          "enum": ["Always", "AsNeeded", "Never"],
          "default": "AsNeeded",
          "description": "Trailing-comma policy for `cypher-fmt`.",
          "scope": "resource"
        },
        "cyrs.formatting.indentStyle": {
          "type": "string",
          "enum": ["Spaces", "Tabs"],
          "default": "Spaces",
          "description": "Indentation style for `cypher-fmt`.",
          "scope": "resource"
        },
        "cyrs.formatting.indentWidth": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "description": "Spaces per indentation level (ignored when `cyrs.formatting.indentStyle` = `Tabs`).",
          "scope": "resource"
        },
        "cyrs.watchedFilesDebounceMs": {
          "type": "integer",
          "default": 250,
          "minimum": 0,
          "maximum": 5000,
          "description": "Debounce window for `workspace/didChangeWatchedFiles` (spec §14, cy-k2r).",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean": "rm -rf out *.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
