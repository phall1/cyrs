// cypher.ungrammar — canonical grammar description for cypher-ast.
//
// Normatively references spec 0001 §5 (AST layer) and §19 (v1 dialect and
// scope matrix). Input to `cargo xtask codegen` (bead cy-dpq), which will
// generate the typed AST wrappers over the `cypher-syntax` CST. This file
// is not compiled; it is text. Where this file is silent and the spec is
// silent, defer to openCypher v9 per AGENTS.md §23.
//
// Scope is the v1 matrix in §19. Constructs listed as deferred there get
// a `// DEFERRED: spec §19 / §20` comment at their point of absence, not
// a production. Do not encode operator precedence here; the Pratt parser
// owns that. List syntactic alternatives under `Expr` only.
//
// Token conventions:
//   'text'        terminal token matched by its source text (keyword/punct)
//   TOKEN_KIND    named token from cypher-syntax::SyntaxKind
//   Node          non-terminal defined below
//   a | b         alternation
//   (a b c)       sequence
//   a*            zero-or-more
//   a+            one-or-more
//   a?            optional
//   field:Node    labeled field (codegen accessor name)

//------------------------------------------------------------------------
// Root
//------------------------------------------------------------------------

SourceFile =
  (Statement (';' Statement)* ';'?)?

Statement =
  SingleQuery
| Union

//------------------------------------------------------------------------
// Queries
//------------------------------------------------------------------------

SingleQuery =
  Clause+

Union =
  head:SingleQuery UnionTail+

UnionTail =
  'UNION' 'ALL'? tail:SingleQuery

Clause =
  MatchClause
| WithClause
| ReturnClause
| UnwindClause
| CallClause
| OptionalCallClause
| CreateClause
| InsertClause
| FilterClause
| MergeClause
| SetClause
| RemoveClause
| DeleteClause

//------------------------------------------------------------------------
// Reading clauses
//------------------------------------------------------------------------

MatchClause =
  'OPTIONAL'? 'MATCH' PathMode? Pattern (',' Pattern)* WhereClause?

// GQL-distinct MATCH path-mode prefix (ISO/IEC 39075:2024 §10.6.3;
// cyrs cy-q2g). The two two-keyword forms select the element-uniqueness
// semantics of the path patterns to the right of MATCH. The parser
// wraps the two keyword tokens in a single `PATH_MODE` child of the
// MATCH clause; the discriminant between the two forms is the leading
// keyword (REPEATABLE vs DIFFERENT).
PathMode =
  'REPEATABLE' 'ELEMENTS'
| 'DIFFERENT' 'EDGES'

WithClause =
  'WITH' 'DISTINCT'? ReturnItems WhereClause? OrderBy? Skip? Limit?

// GQL ISO/IEC 39075:2024 §14.13:
//   - `ALL` is an explicit synonym for the default multiset semantics
//     (§14.13.2); accepted in the same slot as `DISTINCT`, mutually
//     exclusive.
//   - `ReturnExclude` is the GQL-distinct field-exclusion trailer
//     (§14.13.4); openCypher has no analogue.
ReturnClause =
  'RETURN' ('DISTINCT' | 'ALL')? ReturnItems ReturnExclude? GroupBy? OrderBy? Skip? Limit?

ReturnExclude =
  'EXCLUDE' NameRef (',' NameRef)*

// GQL `groupByClause` (§14.13.3) — slots between EXCLUDE and ORDER BY
// in the return-body trailer.  The grouping-element list is a plain
// comma-separated `Expr` list; ISO's empty grouping `()` and
// `GROUPING SETS / ROLLUP / CUBE` extensions are deferred (cy-71t0
// follow-ups).
GroupBy =
  'GROUP' 'BY' Expr (',' Expr)*

UnwindClause =
  'UNWIND' expr:Expr 'AS' bind:NameDef

CallClause =
  'CALL' name:QualifiedName ( '(' ArgList? ')' )? YieldClause?
// DEFERRED: `CALL { <subquery> }` form — spec §19 / §20 D1.

// `OPTIONAL CALL` — GQL ISO/IEC 39075:2024 §14.11.3 (cy-tdl). Same body
// shape as `CallClause`, but signals optional invocation (empty multiset
// on failure rather than error propagation). Emitted as a distinct node
// so HIR can model the optional semantics without touching `CallClause`.
OptionalCallClause =
  'OPTIONAL' 'CALL' name:QualifiedName ( '(' ArgList? ')' )? YieldClause?

YieldClause =
  'YIELD' ( '*' | YieldItem (',' YieldItem)* ) WhereClause?

//------------------------------------------------------------------------
// Writing clauses
//------------------------------------------------------------------------

CreateClause =
  'CREATE' Pattern (',' Pattern)*

// GQL-distinct write clause (ISO/IEC 39075:2024 §13.4; cyrs cy-8z3).
// The optional NODE / EDGE qualifier is consumed by the parser as a
// contextual identifier (not a reserved keyword) so openCypher's
// `:NODE` / `:EDGE` label patterns keep lexing as ordinary patterns;
// the qualifier therefore does not appear here as a typed token.
InsertClause =
  'INSERT' Pattern (',' Pattern)*

// GQL post-projection row filter (ISO/IEC 39075:2024 §14.10; cyrs cy-r50).
// Same shape as WhereClause but lives at clause level so it can chain
// after a RETURN / WITH projection.
FilterClause =
  'FILTER' Expr

MergeClause =
  'MERGE' Pattern MergeAction*

MergeAction =
  'ON' ('CREATE' | 'MATCH') SetClause

SetClause =
  'SET' SetItem (',' SetItem)*

RemoveClause =
  'REMOVE' RemoveItem (',' RemoveItem)*

DeleteClause =
  'DETACH'? 'DELETE' Expr (',' Expr)*

//------------------------------------------------------------------------
// Shared fragments
//------------------------------------------------------------------------

WhereClause =
  'WHERE' Expr

OrderBy =
  'ORDER' 'BY' SortItem (',' SortItem)*

// GQL §14.13.6 `sortSpecification` — an optional `orderingSpecification`
// (`ASC` / `DESC`) and an optional `nullOrdering` trailer.  The
// `nullOrdering` is GQL-distinct (openCypher v9 has no surface for it).
// cy-z0x8.
SortItem =
  Expr ('ASC' | 'DESC')? NullOrdering?

// GQL §14.13.6 `nullOrdering` — `NULLS FIRST` or `NULLS LAST`.
NullOrdering =
  'NULLS' ('FIRST' | 'LAST')

// GQL §14.13.7 `offsetClause` — `SKIP` and `OFFSET` are surface
// synonyms (`offsetSynonym`).  The CST node is the same for both
// spellings; the contained keyword token records the surface form.
// cy-z0x8 added the `OFFSET` arm.
Skip =
  ('SKIP' | 'OFFSET') Expr

Limit =
  'LIMIT' Expr

// Per spec §7.3 / §19 row "RETURN / DISTINCT / *":
// `*` may stand alone or be mixed with explicit items as a trailing form.
// TODO: verify against TCK — the `*` mid-list form is openCypher-permissive.
ReturnItems =
  '*' (',' ReturnItem)*
| ReturnItem (',' ReturnItem)* (',' '*')?

ReturnItem =
  Expr ('AS' alias:NameDef)?

YieldItem =
  name:NameRef ('AS' alias:NameDef)?

// SetItem covers (spec §19, row "SET properties, labels, map"):
//   a.prop = expr            property assignment
//   a:Lab1:Lab2              label add
//   a = { ... }              whole-node/rel replace
//   a += { ... }             merge form (map-merge into existing entity)
SetItem =
  PropertyAssign
| LabelAdd
| NodeReplace
| NodeMerge

PropertyAssign =
  target:PropertyAccess '=' value:Expr

LabelAdd =
  target:NameRef LabelExpr

NodeReplace =
  target:NameRef '=' value:Expr

NodeMerge =
  target:NameRef '+=' value:Expr

// RemoveItem covers property removal and label removal (spec §19).
RemoveItem =
  PropertyRemove
| LabelRemove

PropertyRemove =
  target:PropertyAccess

LabelRemove =
  target:NameRef LabelExpr

//------------------------------------------------------------------------
// Patterns
//------------------------------------------------------------------------

// A Pattern is a single path expression (with optional path-binder). A
// clause like MATCH splits multiple patterns with `,` at the clause level,
// which is why MatchClause/CreateClause list `Pattern (',' Pattern)*`.
Pattern =
  (bind:NameDef '=')? PathPattern

PathPattern =
  ShortestPathPattern
| PathElement+

ShortestPathPattern =
  ('shortestPath' | 'allShortestPaths') '(' PathElement+ ')'

PathElement =
  NodePattern (RelPattern NodePattern)*

NodePattern =
  '(' NameDef? LabelExpr? PropertyMap? ')'

// Relationship syntax — directed and undirected. The three arrow shapes
// map to ARROW_L/ARROW_R tokens from cypher-syntax::SyntaxKind.
RelPattern =
  '<-' '[' RelDetail? ']' '-'
| '-'  '[' RelDetail? ']' '->'
| '-'  '[' RelDetail? ']' '-'

RelDetail =
  NameDef? TypeExpr? RangeHops? PropertyMap?

// Variable-length hops: `*`, `*n`, `*n..`, `*n..m`, `*..m`.
RangeHops =
  '*' (IntLiteral ('..' IntLiteral?)?)?
| '*' '..' IntLiteral

// v1 label usage is a simple colon-separated list on nodes, and a
// `|`-separated disjunction on relationships (spec §19 row
// "Pattern: relationship type disjunction"). Richer GQL label-expr
// algebra (`!`, `&`, parenthesised) tracks §9.2 and lives behind the
// dialect gate — the ungrammar lists only the v1 surface.
LabelExpr =
  (':' Label)+

TypeExpr =
  ':' RelType ('|' RelType)*

PropertyMap =
  '{' (PropertyKV (',' PropertyKV)*)? '}'

PropertyKV =
  key:PropertyKey ':' value:Expr

//------------------------------------------------------------------------
// Expressions
//
// Pratt precedence is the parser's job. This file only enumerates the
// syntactic shapes the AST must wrap. One large alternation under Expr,
// with a dedicated production per shape.
//------------------------------------------------------------------------

Expr =
  Literal
| ParameterExpr
| VariableRef
| PropertyAccess
| IndexAccess
| IndexExpr
| SliceExpr
| FunctionCall
| CountStar
| ParenExpr
| ListLiteral
| MapLiteral
| MapProjection
| ListComprehension
| ListPredicateExpr
| PatternComprehension
| CaseExpr
| NullCheck
| IsTypedExpr
| TypeCastExpr
| ExistsPredicate
| BinaryExpr
| UnaryExpr
| StringPatternExpr
| MembershipExpr
| PatternPredicate
// --- cy-p1u5 EXISTS parser-only ---
| ExistsSubqueryExpr
// --- end cy-p1u5 ---
// --- cy-dwem truthValue predicate ---
| TruthValuePredicate
// --- end cy-dwem ---

// DEFERRED: `COUNT { ... }` expression forms — spec §19 / §20 D1.
//
// `EXISTS { <Statement> }` / `EXISTS ( MATCH … )` are parser-accepted
// but semantically deferred (cy-p1u5, spec §0 amendment 2026-05-19).
// The CST shape is captured by `ExistsSubqueryExpr`; sema's
// `exists_subquery` dialect-gate (E4017) rejects every occurrence so
// spec §20 D1 / N4 stay in force at the semantic surface.

Literal =
  IntLiteral
| FloatLiteral
| StringLiteral
| BoolLiteral
| NullLiteral

IntLiteral    = INT_NUMBER
FloatLiteral  = FLOAT_NUMBER
StringLiteral = STRING
BoolLiteral   = 'TRUE' | 'FALSE'
NullLiteral   = 'NULL'

ParameterExpr =
  PARAMETER

VariableRef =
  NameRef

// Chained dotted access: `a.b.c`. The parser decomposes nested heads.
PropertyAccess =
  receiver:Expr '.' key:PropertyKey

IndexAccess =
  receiver:Expr '[' index:Expr ']'

// cy-7s6.1: typed list indexing and slicing. `IndexExpr` matches
// `xs[0]` / `xs[-1]`; `SliceExpr` matches `xs[i..j]`, `xs[..j]`,
// `xs[i..]`. Both can chain (`xs[0..3][0]`). v1 scope is LIST only;
// STRING indexing lands in a follow-up bead (see HIR lowering note).
IndexExpr =
  receiver:Expr '[' index:Expr ']'

SliceExpr =
  receiver:Expr '[' start:Expr? '..' end:Expr? ']'

// `DISTINCT` inside a call is the inline aggregation form (`count(DISTINCT x)`).
FunctionCall =
  name:QualifiedName '(' 'DISTINCT'? ArgList? ')'

ArgList =
  Expr (',' Expr)*

CountStar =
  'COUNT' '(' '*' ')'

ParenExpr =
  '(' Expr ')'

ListLiteral =
  '[' (Expr (',' Expr)*)? ']'

MapLiteral =
  '{' (PropertyKV (',' PropertyKV)*)? '}'

// `n { .name, age: 30, .*, * }` — map projection over a subject expression
// (cy-01q). Desugared in HIR (spec §6.1) into an explicit map construction.
// Distinguished from a bare `MapLiteral` syntactically by requiring the
// `{ ... }` to follow another expression as a postfix trailer (handled by
// the Pratt parser's postfix dispatch). The first `Expr` child is the
// subject; the `MapProjectionItem` list spells out the projection.
MapProjection =
  subject:Expr '{' (MapProjectionItem (',' MapProjectionItem)*)? '}'

// One projection item. Four shapes per openCypher / GQL:
//   `.name`        — property selector  (DOT followed by property key)
//   `.*`           — all-properties spread of the subject (DOT '*' STAR)
//   `*`            — all-bound-vars spread (rare; STAR alone)
//   `key: Expr`    — literal item (IDENT ':' Expr)
// The four kinds are not modeled as a sum type in the ungrammar — HIR
// lowering inspects the first significant token of each item to classify.
MapProjectionItem =
  '.' (PropertyKey | '*')
| '*'
| key:PropertyKey ':' value:Expr

// `[ v IN xs WHERE p(v) | e(v) ]`. Desugared in HIR (spec §6.1).
ListComprehension =
  '[' bind:NameDef 'IN' source:Expr WhereClause? ('|' projection:Expr)? ']'

// `ANY|ALL|NONE|SINGLE(v IN xs WHERE p(v))` — list predicate (cy-8x5).
// The discriminant is the first keyword token child; the `WHERE` clause
// is optional (bare `ANY(x IN xs)` returns true iff xs is non-empty).
// Result type is BOOLEAN. Shared across GqlAligned / OpenCypherV9.
ListPredicateExpr =
  ('ANY' | 'ALL' | 'NONE' | 'SINGLE')
  '(' bind:NameDef 'IN' source:Expr WhereClause? ')'

// `[ (a)-[r]->(b) WHERE p | e ]`. Desugared in HIR (spec §6.1).
PatternComprehension =
  '[' path:PathPattern WhereClause? '|' projection:Expr ']'

// `CASE` with optional scrutinee, one or more `CaseWhenArm` children,
// and an optional trailing `CaseElseArm` — spec §19 row "CASE" (cy-41u).
// The arms and else branch are wrapped in dedicated nodes so the typed
// AST can address them directly; the parser emits the corresponding
// `CASE_WHEN_ARM` / `CASE_ELSE_ARM` SyntaxKind nodes.
CaseExpr =
  'CASE' scrutinee:Expr? arms:CaseWhenArm+ else_arm:CaseElseArm? 'END'

CaseWhenArm =
  'WHEN' when_value:Expr 'THEN' then_value:Expr

CaseElseArm =
  'ELSE' value:Expr

NullCheck =
  operand:Expr 'IS' 'NOT'? 'NULL'

// GQL type-assertion productions (cy-pnp, ISO/IEC 39075:2024 §6.5.2).
// `IS TYPED <Type>` is GQL's predicate form; `<expr> :: <Type>` is the
// typed-value shorthand. Both carry a `TypeName` child that names the
// asserted type (one or more identifier tokens, see `TypeName`). The
// parser places these at comparison-level precedence so a following
// comparison continues to parse — `n.age :: INTEGER > 18` yields
// `((n.age) :: INTEGER) > 18`.
IsTypedExpr =
  operand:Expr 'IS' 'NOT'? 'TYPED' ty:TypeName

// GQL truthValuePredicatePart2 (cy-dwem, ISO/IEC 39075:2024 §20.1).
// The truth-value tail is one of the three keyword tokens TRUE / FALSE
// / UNKNOWN; the CST emits TRUE_KW / FALSE_KW / UNKNOWN_KW directly so
// downstream code can inspect the token kind without an enum wrapper.
TruthValuePredicate =
  operand:Expr 'IS' 'NOT'? ('TRUE' | 'FALSE' | 'UNKNOWN')

TypeCastExpr =
  operand:Expr '::' ty:TypeName

// GQL named type — one or more identifier tokens (`INTEGER`, `STRING`,
// `ZONED DATETIME`, …). The constituent tokens are ordinary IDENTs at
// the lexer level so the names remain available as variable / label
// identifiers elsewhere; the parser collects them greedily, capped at
// three tokens (see `MAX_TYPE_NAME_IDENTS`) so a stray identifier later
// in the expression is not silently absorbed.
TypeName =
  NameRef NameRef*

// Predicate form only. The `EXISTS { <subquery> }` form is deferred.
ExistsPredicate =
  'EXISTS' '(' (PathPattern | Expr) ')'

// Pattern predicate in expression position, e.g. `(a)-[:R]->(:X)` in WHERE.
// Desugared in HIR (spec §6.1).
PatternPredicate =
  PathPattern

// --- cy-p1u5 EXISTS parser-only ---
// `EXISTS { <Statement> }` (ISO/IEC 39075:2024 §10.7) and
// `EXISTS ( MATCH … )` (ISO §14.10) subquery expression — bead cy-p1u5.
//
// Parser-accepted, semantically deferred per spec §20 D1 / N4: HIR
// lowering produces an inert `Expr::ExistsSubqueryDeferred` marker
// and sema's `exists_subquery` dialect-gate (E4017) rejects every
// occurrence. The body is captured as a generic `Statement` node so
// a future spec lifting D1 can pick it up without re-parsing.
ExistsSubqueryExpr =
  'EXISTS' ('{' Statement '}' | '(' Statement ')')
// --- end cy-p1u5 ---

// Arithmetic, comparison, boolean. The parser assigns precedence; the
// ungrammar only claims the shape.
BinaryExpr =
  lhs:Expr op:BinaryOp rhs:Expr

BinaryOp =
  '+' | '-' | '*' | '/' | '%' | '^'
| '=' | '<>' | '!=' | '<' | '<=' | '>' | '>='
| 'AND' | 'OR' | 'XOR'

UnaryExpr =
  op:UnaryOp operand:Expr

UnaryOp =
  '-' | 'NOT'

// String-pattern operators share precedence with comparison but have
// distinct shapes worth naming for codegen.
StringPatternExpr =
  lhs:Expr op:StringPatternOp rhs:Expr

StringPatternOp =
  '=~'
| 'STARTS' 'WITH'
| 'ENDS'   'WITH'
| 'CONTAINS'

MembershipExpr =
  lhs:Expr 'IN' rhs:Expr

//------------------------------------------------------------------------
// Names
//------------------------------------------------------------------------

NameDef =
  IDENT
| QUOTED_IDENT

NameRef =
  IDENT
| QUOTED_IDENT

QualifiedName =
  IDENT ('.' IDENT)*

Label =
  IDENT

RelType =
  IDENT

PropertyKey =
  IDENT
| QUOTED_IDENT
