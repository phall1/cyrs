/target
**/*.rs.bk
Cargo.lock.bak

# IDE / OS crud
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.DS_Store

# coverage output
/coverage
lcov.info

# bench artefacts — criterion output and build cache are not checked in.
benches/target
benches/Cargo.lock

# fuzz artefacts — generated corpus and crash inputs are not checked in.
# Seed corpus files (fuzz/corpus/<target>/seed*) ARE checked in.
fuzz/target
fuzz/artifacts
# fuzz/ is a standalone workspace (see fuzz/Cargo.toml [workspace]). The
# lockfile it generates is a developer convenience; like benches/Cargo.lock
# it is not part of the committed tree.
fuzz/Cargo.lock
# Ignore fuzzer-generated corpus entries but keep our seed files.
# (cargo fuzz writes new inputs as hex-named files; seeds are named seed*)
fuzz/corpus/**/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*

# bv (beads viewer) local config and caches
.bv/

# Claude Code session state (orchestrator runtime, worktrees, settings)
.claude/

# Local beads reports (generated by bv / br, not meant to be committed)
beads_report_*.md

# cypher-wasm generated build output (wasm-bindgen JS wrapper + .wasm
# artifacts).  Populated by `cargo xtask wasm-build`; never committed.
crates/cypher-wasm/pkg/
