# fuzz_parser-specific extras — shapes that drive the recovering parser
# into, and out of, every named recovery region (E0001..E0999) as well as
# the rarely-hit pattern-comprehension and list-comprehension branches.

# Clause-order bait — exercise recovery on missing/duplicate clauses.
"RETURN"
"RETURN n MATCH (x)"
"WITH MATCH"
"WHERE WHERE"
"OPTIONAL OPTIONAL MATCH"
"MERGE MATCH"
"CREATE UNWIND"
"YIELD WITHOUT"
"UNION MATCH"

# Unbalanced delimiters — recovery stress.
"("
")"
"(("
"))"
"("
"[["
"]]"
"{{"
"}}"
"((n)"
"[n])"
"{n:1"
"(n"
"(n]"
"(n}"
"[n)"

# Pattern comprehension + quantified pattern shapes.
"[(n)-->(m) WHERE n.k=1 | n.name]"
"[x IN xs WHERE x > 0 | x*x]"
"[x IN [1,2,3] | x]"
"[x IN xs | x]"
"[(a)-[:KNOWS*1..3]->(b)]"
"(n)-[:R*1..3]->(m)"
"(n)-[:R*]->(m)"
"(n)-[:R*..]->(m)"
"(n)-[:R*1..]->(m)"
"((a)-[:R]->(b)){2,5}"

# List-comprehension + range bait.
"[x IN range(1,10) | x]"
"[1..10]"
"[1..]"
"[..10]"
"range(1, 10)"
"range(1, 10, 2)"

# CASE + expression forms.
"CASE WHEN TRUE THEN 1 ELSE 0 END"
"CASE x WHEN 1 THEN 'a' WHEN 2 THEN 'b' ELSE 'c' END"
"CASE WHEN END"
"CASE END"
"CASE x END"

# Subquery-ish shapes (must reject cleanly per §9 v1 scope).
"CALL { MATCH (n) RETURN n }"
"EXISTS { MATCH (n) }"
"EXISTS { (n)-[:R]->(m) }"
"COUNT { MATCH (n) }"
"COLLECT { MATCH (n) RETURN n }"

# Path-assignment and multi-pattern comma bait.
"p = (a)-[r]->(b)"
"MATCH p = (a)-[r]->(b)"
"MATCH (a), (b)"
"MATCH (a)-->(b), (b)-->(c)"

# Parameter shapes.
"$foo"
"$1"
"${"
"$."
"${x}"
