# fuzz_sema-specific extras — shapes that exercise name resolution,
# scope building, and schema-free semantic checks (E1000–E2999).

# Undeclared / shadowed variable bait.
"RETURN undeclared"
"MATCH (n) RETURN other"
"MATCH (n) MATCH (n) RETURN n"
"MATCH (n) WITH n AS m RETURN n"
"MATCH (n) WITH n AS n RETURN n"
"UNWIND [1,2,3] AS x UNWIND [4,5] AS x RETURN x"
"WITH 1 AS n MATCH (n) RETURN n"

# Aggregation + grouping bait.
"RETURN count(*)"
"RETURN count(n)"
"RETURN count(DISTINCT n)"
"MATCH (n) RETURN n, count(*)"
"MATCH (n) RETURN count(*), n"
"RETURN sum(x), avg(x), min(x), max(x), collect(x)"
"WITH count(*) AS c RETURN c"
"WITH n, count(*) AS c RETURN n, c"

# WITH-pipeline scope rules.
"MATCH (n) WITH n RETURN n"
"MATCH (n) WITH n AS m RETURN m"
"MATCH (n) WITH * RETURN n"
"MATCH (n) WITH n.k AS k RETURN k"
"MATCH (n) WITH n ORDER BY n.k RETURN n"
"MATCH (n) WITH n SKIP 10 LIMIT 10 RETURN n"

# Property access + indexing.
"n.prop"
"n.prop.sub"
"n[0]"
"n[0..5]"
"n[..5]"
"n[5..]"
"map.key"
"map['key']"
"[1,2,3][0]"

# Type-system bait.
"1 + 'a'"
"true + false"
"null + null"
"[] + []"
"{a:1} + {b:2}"
"size([1,2,3])"
"size('abc')"
"size({})"

# Parameter use.
"RETURN $p"
"MATCH (n {k: $p}) RETURN n"
"WITH $p AS p RETURN p"

# Predicate / IN / STARTS / ENDS shapes.
"WHERE n IN [1,2,3]"
"WHERE n.k STARTS WITH 'foo'"
"WHERE n.k ENDS WITH 'bar'"
"WHERE n.k CONTAINS 'baz'"
"WHERE NOT n.k = 1"
"WHERE n IS NULL"
"WHERE n IS NOT NULL"

# Label-expression + relationship-type bait.
"(n:A|B)"
"(n:A&B)"
"(n:A:B)"
"(n:!A)"
"-[r:A|B]->"
"-[r:A&B]->"
