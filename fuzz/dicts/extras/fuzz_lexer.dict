# fuzz_lexer-specific extras — lexical edge cases not covered by the
# shared base. The lexer is driven by logos; these shapes target
# byte-level branch conditions in crates/cypher-syntax/src/kind.rs and
# the escape-handling paths in the string-literal rules.

# String escapes — every escape class the lexer recognises.
"'\\n'"
"'\\r'"
"'\\t'"
"'\\b'"
"'\\f'"
"'\\0'"
"'\\\\'"
"'\\''"
"'\\\"'"
"'\\u0041'"
"'\\U00000041'"
"'\\x41'"
"'no trailing quote"
"\"no trailing quote"
"'''"
"\"\"\""

# Numeric edge shapes.
"0x0"
"0xFF"
"0xffff_ffff"
"0o0"
"0o777"
"0b0"
"0b1010"
"1_000_000"
"1e"
"1e+"
"1e-"
"1.e10"
".5"
"1."
"1_.5"

# Whitespace / comment shapes.
"// line comment\n"
"/* block comment */"
"/* unterminated"
"\t"
"\r"
"\r\n"
"\n\n"
" "
"  "
"\x0c"
"\x0b"
"\u00a0"

# Identifier / keyword adjacency — splicing these should trigger max-munch.
"MATCHA"
"MATCH1"
"1MATCH"
"MATCH//x"
"MATCH/*x*/"
"__proto__"
"_0"
"a$b"
"a.b.c.d"
"#not_a_pragma"

# Backtick escape shapes.
"`\\``"
"`\\n`"
"`MATCH`"
"`123`"

# Bare sigils that the lexer must classify.
"@"
"?"
"~"
"$$"
"\\$"
"$$name$$"
"&&"
"||"
"!!"
