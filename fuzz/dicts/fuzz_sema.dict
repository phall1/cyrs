"RETURN sum(x), avg(x), min(x), max(x), collect(x)"
"WITH count(*) AS c RETURN c"
"WITH n, count(*) AS c RETURN n, c"

# WITH-pipeline scope rules.
"MATCH (n) WITH n RETURN n"
