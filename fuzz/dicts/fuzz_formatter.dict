"*/"

# Comment placements that break many formatters.
"MATCH /* inline */ (n)"
"MATCH // eol\x0a(n)"
"RETURN /* a */ n /* b */"
"WITH // x\x0an AS n"
"-- sql-style"
"#shebang-ish"

# Alignment bait: already-multi-line vs inline.
"MATCH (n)\x0aRETURN n"
"MATCH\x0a(n)\x0aRETURN\x0an"
"MATCH   (n)"
"RETURN    n   ,   m"
"MATCH(n)RETURN n"

