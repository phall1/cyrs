# libFuzzer dictionary for Cypher — shared base (cy-h07 / cy-h07.1).
#
# This file is the canonical token source. Per-target dicts under
# fuzz/dicts/<target>.dict embed this content plus target-specific extras.
# Run `fuzz/dicts/regen.sh` after editing this file to refresh them.
#
# Regeneration: keep in sync with crates/cypher-syntax/src/kind.rs.
# Every `*_KW` variant in that file MUST appear below; see
# docs/fuzz-runbook.md for the refresh procedure.
#
# Format: one C-string per line, libFuzzer-native (same as clang's -fuzzer).
# Blank lines and `#` comments are ignored by libFuzzer.

# ==========================================================================
# Keywords (mirrors MATCH_KW..ALLSHORTESTPATHS_KW in kind.rs)
# ==========================================================================
"MATCH"
"OPTIONAL"
"WHERE"
"WITH"
"RETURN"
"CREATE"
"MERGE"
"DELETE"
"DETACH"
"SET"
"REMOVE"
"UNWIND"
"CALL"
"YIELD"
"ON"
"AS"
"AND"
"OR"
"XOR"
"NOT"
"IN"
"IS"
"NULL"
"TRUE"
"FALSE"
"CASE"
"WHEN"
"THEN"
"ELSE"
"END"
"ORDER"
"BY"
"ASC"
"ASCENDING"
"DESC"
"DESCENDING"
"SKIP"
"LIMIT"
"DISTINCT"
"UNION"
"ALL"
"STARTS"
"ENDS"
"CONTAINS"
"DIV"
"MOD"
"COUNT"
"EXISTS"
"SHORTESTPATH"
"ALLSHORTESTPATHS"
"ANY"
"NONE"
"SINGLE"

# ==========================================================================
# Operators and punctuation
# ==========================================================================
"="
"<>"
"!="
"<"
"<="
">"
">="
"+"
"-"
"*"
"/"
"%"
"^"
":"
"::"
";"
"."
".."
","
"("
")"
"["
"]"
"{"
"}"
"->"
"<-"
"<->"
"|"
"=~"
"$"
"!"
"&"
"@"
"?"

# Directional pattern edges, a common fuzzer-starvation shape.
"-[]->"
"<-[]-"
"-[:R]->"
"-[*..]-"
"-[*1..3]-"
"<-[:R*]->"

# ==========================================================================
# Literal patterns
# ==========================================================================
"'alpha'"
"\"alpha\""
"''"
"\"\""
"'it\\'s'"
"\"he said \\\"hi\\\"\""
"0"
"123"
"-1"
"3.14"
"0.0"
"1e10"
"1.5e-3"
"0xdeadbeef"
"null"
"NULL"
"true"
"false"
"TRUE"
"FALSE"
"$param"
"$0"
"$1"
"$name_0"
"`weird name`"
"`with space`"
"`with:colon`"
"``"

# ==========================================================================
# Unicode edge cases (NUL, DEL, BOM, combining mark, RTL marker, emoji, …)
# ==========================================================================
"\\x00"
"\\x01"
"\\x0a"
"\\x0d"
"\\x1b"
"\\x7f"
"\\xef\\xbb\\xbf"
"\\xe2\\x80\\x8e"
"\\xe2\\x80\\x8f"
"\\xe2\\x80\\xa8"
"\\xe2\\x80\\xa9"
"\\xcc\\x81"
"\\xf0\\x9f\\x98\\x80"
"\\xf0\\x9f\\x92\\xa9"

# ==========================================================================
# Common identifier shapes — name resolution fuzz bait
# ==========================================================================
"n"
"m"
"r"
"p"
"x"
"y"
"a"
"b"
"c"
"node"
"rel"
"Person"
"Company"
"KNOWS"
"WORKS_AT"
"HAS_"

# ==========================================================================
# Small valid Cypher fragments — libFuzzer's "token" recombination tends
# to splice these into structural positions that random bytes never reach.
# ==========================================================================
"MATCH (n)"
"MATCH (n) "
"RETURN n"
"(n)"
"(n:Person)"
"(n {k: 1})"
"-[r]->"
"-[:KNOWS]->"
"n.foo"
"n.foo.bar"
"WHERE n.k = 1"
"ORDER BY n.k"
"SKIP 1"
"LIMIT 1"
"WITH n "
"UNWIND [1,2,3] AS x"
"CREATE (n)"
"OPTIONAL MATCH (n)"
"CASE WHEN x THEN y ELSE z END"
"[1, 2, 3]"
"{k: 1}"
"count(*)"
"size(list)"
"[1..5]"
"n[0]"
"DISTINCT n"
"ON CREATE SET"
"ON MATCH SET"
"DETACH DELETE"
"UNION ALL"
"IS NULL"
"IS NOT NULL"
"STARTS WITH"
"ENDS WITH"
"CONTAINS"
"NOT IN"
"MATCH (n) RETURN n"
"MATCH (n)-[r]->(m) RETURN n, r, m"
"MERGE (n:Label {k: $p})"
"ON CREATE SET n.k = 1"
"ON MATCH SET n.k = n.k + 1"
"WITH * RETURN *"
"RETURN *"
"YIELD *"
