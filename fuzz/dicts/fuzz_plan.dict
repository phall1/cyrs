# ===== Target-specific extras =====
# fuzz_plan-specific extras — shapes that drive the HIR→plan lowerer
# through every plan-operator branch: scan, expand, filter, project,
# aggregate, sort, skip/limit, distinct, union, optional-match.

# Scan seeds.
"MATCH (n) RETURN n"
"MATCH (n:Person) RETURN n"
"MATCH (n:Person {id: 1}) RETURN n"
"MATCH (n:Person), (m:Company) RETURN n, m"

# Expand seeds (every direction).
"MATCH (n)-[r]->(m) RETURN n, r, m"
"MATCH (n)<-[r]-(m) RETURN n, r, m"
"MATCH (n)-[r]-(m) RETURN n, r, m"
"MATCH (a)-[r:KNOWS]->(b) RETURN a, r, b"
"MATCH (a)-[r:KNOWS|WORKS_AT]->(b) RETURN a, r, b"
"MATCH (a)-[r*1..3]->(b) RETURN a, r, b"
"MATCH (a)-[r*]->(b) RETURN a, r, b"

# Filter via WHERE on various expression shapes.
"MATCH (n) WHERE n.age > 18 RETURN n"
"MATCH (n) WHERE n.age BETWEEN 1 AND 99 RETURN n"
"MATCH (n) WHERE n.name = 'foo' RETURN n"
"MATCH (n) WHERE n.name STARTS WITH 'A' RETURN n"
"MATCH (n) WHERE n.k IS NOT NULL RETURN n"
"MATCH (n) WHERE NOT (n:Person) RETURN n"

# Projection bait.
"MATCH (n) RETURN n.name AS name"
"MATCH (n) RETURN n.name, n.age"
"MATCH (n) RETURN n.name AS x ORDER BY x"
"MATCH (n) RETURN *"
"MATCH (n) RETURN DISTINCT n"

# Aggregation.
"MATCH (n) RETURN count(*)"
"MATCH (n) RETURN n.k, count(*)"
"MATCH (n)-[r]->(m) RETURN n, count(r)"
"MATCH (n) RETURN sum(n.score)"
"MATCH (n) RETURN collect(n)"
"MATCH (n) RETURN avg(n.age), min(n.age), max(n.age)"

# Sort / skip / limit.
"MATCH (n) RETURN n ORDER BY n.k"
"MATCH (n) RETURN n ORDER BY n.k ASC"
"MATCH (n) RETURN n ORDER BY n.k DESC"
"MATCH (n) RETURN n ORDER BY n.k DESC, n.j ASC"
"MATCH (n) RETURN n SKIP 10"
"MATCH (n) RETURN n LIMIT 10"
"MATCH (n) RETURN n SKIP 10 LIMIT 10"
"MATCH (n) RETURN n ORDER BY n.k SKIP 1 LIMIT 2"

# Union.
"MATCH (n) RETURN n UNION MATCH (m) RETURN m"
"MATCH (n) RETURN n UNION ALL MATCH (m) RETURN m"

# Optional match.
"OPTIONAL MATCH (n) RETURN n"
"MATCH (a) OPTIONAL MATCH (a)-[r]->(b) RETURN a, b"

# Create / merge / set / delete — write-side plan ops.
"CREATE (n:Person {name: 'a'})"
"CREATE (a)-[:KNOWS]->(b)"
"MERGE (n:Person {id: 1})"
"MERGE (n) ON CREATE SET n.k = 1"
"MERGE (n) ON MATCH SET n.k = 2"
"MATCH (n) SET n.k = 1"
"MATCH (n) SET n += {k: 1}"
"MATCH (n) SET n = {k: 1}"
"MATCH (n) REMOVE n.k"
"MATCH (n) REMOVE n:Label"
"MATCH (n) DELETE n"
"MATCH (n) DETACH DELETE n"

# Unwind-driven row sources.
"UNWIND [1,2,3] AS x RETURN x"
"UNWIND range(1, 100) AS x RETURN x"
"UNWIND [] AS x RETURN x"
